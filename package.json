{
	"name": "xcwds.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.57.0",
		"@skeletonlabs/skeleton": "^4.10.0",
		"@skeletonlabs/skeleton-svelte": "^4.10.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.0.15",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1",
		"@xcwds/testing": "^0.1.0",
		"@resvg/resvg-js": "^2.6.2"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"tailwindcss": "^4.1.18",
		"@xcwds/core": "^0.1.0",
		"@xcwds/sveltekit": "^0.1.0",
		"@xcwds/plugin-shell": "^0.1.0",
		"@xcwds/plugin-theme": "^0.1.0",
		"@xcwds/plugin-offline": "^0.1.0",
		"@xcwds/plugin-update": "^0.1.0",
		"@xcwds/plugin-install": "^0.1.0",
		"@xcwds/plugin-settings": "^0.1.0",
		"@xcwds/plugin-tools": "^0.1.0",
		"@xcwds/plugin-timers": "^0.1.0",
		"@xcwds/plugin-share": "^0.1.0",
		"@xcwds/plugin-changelog": "^0.1.0",
		"xcwds-app": "link:src/plugins/app",
		"xcwds-app-coffee-timer": "link:src/plugins/coffee-timer",
		"xcwds-app-cooking-timer": "link:src/plugins/cooking-timer",
		"xcwds-app-oven-time": "link:src/plugins/oven-time",
		"xcwds-app-pizza-dough": "link:src/plugins/pizza-dough",
		"xcwds-app-recipes": "link:src/plugins/recipes",
		"xcwds-app-url-sanitizer": "link:src/plugins/url-sanitizer",
		"xcwds-app-weightlifting": "link:src/plugins/weightlifting"
	},
	"pnpm": {
		"overrides": {
			"vite": "$vite"
		}
	}
}
