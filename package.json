		"xcwds-app-photo-cleaner": "link:src/plugins/photo-cleaner",
		"xcwds-app-pizza-dough": "link:src/plugins/pizza-dough",
		"xcwds-app-qr": "link:src/plugins/qr",
		"xcwds-app-recipes": "link:src/plugins/recipes",
		"xcwds-app-self-control": "link:src/plugins/self-control",
		"xcwds-app-url-sanitizer": "link:src/plugins/url-sanitizer",
		"xcwds-app-voice-memos": "link:src/plugins/voice-memos",
		"xcwds-app-weightlifting": "link:src/plugins/weightlifting"
	}
