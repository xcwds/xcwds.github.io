{
	"name": "xcwds.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^10.0.0",
		"@playwright/test": "^1.57.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.0.0",
		"@vitest/browser-playwright": "^4.0.15",
		"@xcwds/testing": "^0.5.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^17.0.0",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^8.3.4",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@xcwds/core": "^0.5.0",
		"@xcwds/plugin-blocks": "^0.6.1",
		"@xcwds/plugin-camera": "^0.5.0",
		"@xcwds/plugin-changelog": "^0.8.0",
		"@xcwds/plugin-install": "^0.9.0",
		"@xcwds/plugin-lock": "^0.8.0",
		"@xcwds/plugin-offline": "^0.8.0",
		"@xcwds/plugin-qr": "^0.5.0",
		"@xcwds/plugin-recorder": "^0.1.0",
		"@xcwds/plugin-settings": "^0.9.0",
		"@xcwds/plugin-share": "^0.8.0",
		"@xcwds/plugin-shell": "^0.8.0",
		"@xcwds/plugin-theme": "^0.8.0",
		"@xcwds/plugin-timers": "^0.8.0",
		"@xcwds/plugin-tools": "^0.10.0",
		"@xcwds/plugin-update": "^0.8.0",
		"@xcwds/plugin-vault": "^0.1.0",
		"@xcwds/sveltekit": "^0.8.0",
		"tailwindcss": "^4.1.18",
		"xcwds-app": "link:src/plugins/app",
		"xcwds-app-camera": "link:src/plugins/camera",
		"xcwds-app-coffee-timer": "link:src/plugins/coffee-timer",
		"xcwds-app-cooking-timer": "link:src/plugins/cooking-timer",
		"xcwds-app-last-done": "link:src/plugins/last-done",
