{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	// .xcwds/types.d.ts tells TypeScript what the @xcwds plugins add to the app and its settings.
	"include": ["src", "vite.config.ts", ".xcwds/types.d.ts"],
	"exclude": ["src/service-worker.ts"]
}
