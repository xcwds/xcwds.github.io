{
	"name": "xcwds",
	"short_name": "xcwds",
	"description": "Everyday tools that stay on your device: recipes, kitchen and gym tools, and a URL sanitizer.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#bfdbfe",
	"theme_color": "#bfdbfe",
	"icons": [
		{
			"src": "/icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml"
		},
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/icons/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "URL Sanitizer",
			"url": "/utils/url-sanitizer"
		},
		{
			"name": "Coffee Timer",
			"url": "/utils/coffee-timer"
		},
		{
			"name": "Cooking Timer",
			"url": "/utils/cooking-timer"
		},
		{
			"name": "Recipes",
			"url": "/recipes"
		}
	],
	"share_target": {
		"action": "/utils/url-sanitizer",
		"method": "GET",
		"enctype": "application/x-www-form-urlencoded",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	}
}
